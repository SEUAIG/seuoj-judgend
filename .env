# AIJ Server Configuration

# 服务器监听地址与端口
AIJ_LISTEN_ADDR=0.0.0.0
AIJ_LISTEN_PORT=9090

# 并发控制：最大同时处理的请求数
AIJ_MAX_CONCURRENT_REQUESTS=6

# 资源目录路径
AIJ_PROBLEMS_DIR=./assets/problems/
AIJ_LOG_DIR=./assets/logs/
AIJ_SUBMISSIONS_DIR=./assets/submissions/

# 后端服务器连接信息
AIJ_BACKEND_HOST=127.0.0.1
AIJ_BACKEND_PORT=8080
AIJ_BACKEND_PREFIX=

# 提交记录与输出设置
# 是否保存提交的文件 (填 true 或 false)
AIJ_SAVE_SUBMISSIONS=true
# 输出内容截断长度 (字符数)
AIJ_OUTPUT_TRUNCATE_LENGTH=200

# 编译限制
# 编译超时时间 (毫秒)
AIJ_COMPILE_TIME_LIMIT_MS=5000
# 编译内存限制 (KB)
AIJ_COMPILE_MEMORY_LIMIT_KB=524288
# 编译错误输出截断长度
AIJ_COMPILE_ERROR_TRUNCATE_LENGTH=1000